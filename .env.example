# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@localhost:5432/internship_finder
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Inbox scan (read-only OAuth scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Key used to encrypt profile PII, EEO answers and OAuth tokens at rest
FIELD_ENCRYPTION_KEY=

# Cover letters
COVER_LETTER_DIR=./out
